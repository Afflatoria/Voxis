# Neural TTS configuration

# Backend: cosyvoice | mock
NEURAL_TTS_BACKEND=cosyvoice

# Path to Fun-CosyVoice3 model directory (after download)
COSYVOICE_MODEL_DIR=pretrained_models/Fun-CosyVoice3-0.5B

# Path to CosyVoice repository (cloned into third_party)
COSYVOICE_REPO=third_party/CosyVoice

# Default reference prompt WAV for zero-shot / instruct synthesis
COSYVOICE_PROMPT_WAV=third_party/CosyVoice/asset/zero_shot_prompt.wav

# Default prompt text prefix for CosyVoice3
COSYVOICE_PROMPT_TEXT=You are a helpful assistant.<|endofprompt|>希望你以后能够做的比我还好呦。

# Server
NEURAL_TTS_HOST=0.0.0.0
NEURAL_TTS_PORT=8000

# CORS (comma-separated origins for frontend dev server)
NEURAL_TTS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
NEURAL_TTS_LOG_LEVEL=INFO

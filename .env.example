# Neural TTS configuration

# Backend: f5tts | mock
NEURAL_TTS_BACKEND=f5tts

# F5-TTS model variant (F5TTS_v1_Base, F5TTS_Base, E2TTS_Base)
F5TTS_MODEL=F5TTS_v1_Base

# Reference voice for zero-shot cloning (~12s max, with ~1s trailing silence)
F5TTS_REF_WAV=assets/voices/reference.wav

# Transcript of the reference WAV (leave empty to auto-transcribe with Whisper on first run)
F5TTS_REF_TEXT=Those who dread us, grant us the most power.

# Optional inference tuning
F5TTS_NFE_STEP=32
F5TTS_CFG_STRENGTH=2.0
F5TTS_STREAM_CHUNK_SIZE=2048

# Server
NEURAL_TTS_HOST=0.0.0.0
NEURAL_TTS_PORT=8000

# CORS (comma-separated origins for frontend dev server)
NEURAL_TTS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
NEURAL_TTS_LOG_LEVEL=INFO
